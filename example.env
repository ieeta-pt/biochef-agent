REGISTRY_URL=myregistry.com
REGISTRY_USERNAME=myregistry
REGISTRY_PASSWORD=12345
REGISTRY_INSECURE=false
ORAS_AUTH_BACKEND=basic
# How a workflow executes: subprocess (on the host, as this user) or apptainer
# (each step in a container). subprocess is the default; apptainer is what you
# want anywhere the data matters.
BIOCHEF_RUNNER=subprocess

# Under the apptainer runner. The image must carry a scheme and must contain
# bash -- snakemake runs each rule as `bash -c` inside it.
BIOCHEF_CONTAINER_IMAGE=docker://debian:stable-slim
BIOCHEF_APPTAINER_CACHE=apptainer-cache

# Apptainer binds the host's /tmp unless told not to, and that is where a run's
# directory lives by default. Without --contain a containerised tool can read
# every other run's data.
BIOCHEF_APPTAINER_ARGS=--contain

# Where a run's private directory is created. Unset means the system temp
# directory.
# BIOCHEF_RUN_ROOT=/var/lib/biochef/runs

BIOCHEF_RUN_TIMEOUT=900
BIOCHEF_KEEP_WORKSPACE=false
BIOCHEF_MAX_UPLOAD_BYTES=536870912
BIOCHEF_TOOL_CACHE=tool-cache

# GA4GH Passports, when BIOCHEF_AUTH=passport. The issuer is required; without
# it the service refuses to start rather than accept a token from anywhere.
# BIOCHEF_PASSPORT_ISSUER=https://login.aai.lifescience-ri.eu/oidc/
# Required. Without it, a token the same issuer minted for ANOTHER service is
# accepted here. Set it to 'any' only if the issuer mints audience-less tokens,
# and understand that this accepts any token that issuer ever signed.
# BIOCHEF_PASSPORT_AUDIENCE=biochef-agent
# BIOCHEF_PASSPORT_JWKS_URL=
# BIOCHEF_PASSPORT_USERINFO_URL=
#
# Whose visas count. A visa is only worth something if its issuer was named in
# advance -- otherwise anybody can mint themselves the visa you are requiring,
# which is why REQUIRE_VISA without VISA_ISSUERS refuses to start.
# BIOCHEF_PASSPORT_VISA_ISSUERS=https://controller.example.org
# BIOCHEF_PASSPORT_REQUIRE_VISA=ControlledAccessGrants
# BIOCHEF_PASSPORT_REQUIRE_VISA_VALUE=https://datasets.example.org/1

# Who may call this service: none (anyone who can reach it) or bearer.
# With bearer, requests need Authorization: Bearer <BIOCHEF_AUTH_TOKEN>.
# Selecting bearer without a token stops the service from starting.
BIOCHEF_AUTH=none
BIOCHEF_AUTH_TOKEN=
