REGISTRY_URL=myregistry.com
REGISTRY_USERNAME=myregistry
REGISTRY_PASSWORD=12345
REGISTRY_INSECURE=false
ORAS_AUTH_BACKEND=basic
# How a workflow executes: subprocess (on the host, as this user) or apptainer
# (each step in a container). subprocess is the default; apptainer is what you
# want anywhere the data matters.
BIOCHEF_RUNNER=subprocess

# Under the apptainer runner. The image must carry a scheme and must contain
# bash -- snakemake runs each rule as `bash -c` inside it.
BIOCHEF_CONTAINER_IMAGE=docker://debian:stable-slim
BIOCHEF_APPTAINER_CACHE=apptainer-cache

# --contain hides other runs' files under /tmp from the container.
# --cleanenv prevents Agent variables from being inherited by tool processes.
BIOCHEF_APPTAINER_ARGS="--contain --cleanenv --net --network none"

# Under the podman runner, required and with no default: disable runs steps
# without SELinux separation and mounts the workspace as it is; keep leaves
# podman's labelling on, which on an SELinux host needs BIOCHEF_RUN_ROOT labelled
# for containers (container_file_t). See the README.
# BIOCHEF_PODMAN_SELINUX=disable

# On unless set to false: the agent refuses to start with a runner it does not
# itself keep off the network (subprocess, or apptainer without --net --network
# none). false is needed for the subprocess runner, and is audited at start.
# BIOCHEF_REQUIRE_NETWORK_ISOLATION=false
# A host:port the agent can reach and a step must not, tried by the network check
# a runner that isolates the network runs at start.
# BIOCHEF_NETWORK_PROBE=

# Under the podman runner, required and with no default: rootless runs podman as
# the agent's user; rootful runs it as root through podman-step-root and one
# sudo rule, with each step as a dedicated user. See the README.
# BIOCHEF_PODMAN_MODE=rootless
# Rootless only, required: the most processes and memory a step may use.
# BIOCHEF_STEP_PIDS=256
# BIOCHEF_STEP_MEMORY=4g
# Rootful only, required: podman-step-root as installed for sudo. The user, the
# image, the limits and SELinux then come from /etc/biochef-agent/podman-step.conf.
# BIOCHEF_PODMAN_HELPER=/usr/local/libexec/biochef-agent/podman-step-root

# Where a run's private directory is created. Unset means the system temp
# directory.
# BIOCHEF_RUN_ROOT=/var/lib/biochef/runs

BIOCHEF_RUN_TIMEOUT=900
BIOCHEF_KEEP_WORKSPACE=false
BIOCHEF_MAX_UPLOAD_BYTES=536870912
BIOCHEF_TOOL_CACHE=tool-cache

# GA4GH Passports, when BIOCHEF_AUTH=passport. The issuer is required; without
# it the service refuses to start rather than accept a token from anywhere.
# BIOCHEF_PASSPORT_ISSUER=https://login.aai.lifescience-ri.eu/oidc/
# Required. Without it, a token the same issuer minted for ANOTHER service is
# accepted here. Set it to 'any' only if the issuer mints audience-less tokens,
# and understand that this accepts any token that issuer ever signed.
# BIOCHEF_PASSPORT_AUDIENCE=biochef-agent
# BIOCHEF_PASSPORT_JWKS_URL=
# BIOCHEF_PASSPORT_USERINFO_URL=
#
# Whose visas count. A visa is only worth something if its issuer was named in
# advance -- otherwise anybody can mint themselves the visa you are requiring,
# which is why REQUIRE_VISA without VISA_ISSUERS refuses to start.
# BIOCHEF_PASSPORT_VISA_ISSUERS=https://controller.example.org
# BIOCHEF_PASSPORT_REQUIRE_VISA=ControlledAccessGrants
# BIOCHEF_PASSPORT_REQUIRE_VISA_VALUE=https://datasets.example.org/1

# An append-only JSONL record of every state each run reaches: who asked, which
# run, which state, when. Unset writes no trail. Append-only is not immutable --
# put it somewhere the service cannot rewrite if that matters. If it cannot be
# written, runs fail rather than proceeding unrecorded.
# BIOCHEF_AUDIT_LOG=/var/log/biochef/audit.jsonl

# Who may call this service: none (anyone who can reach it) or bearer.
# With bearer, requests need Authorization: Bearer <BIOCHEF_AUTH_TOKEN>.
# Selecting bearer without a token stops the service from starting.
BIOCHEF_AUTH=none
BIOCHEF_AUTH_TOKEN=

# How many runs are remembered for polling. The oldest finished run is
# forgotten when full; a new request is refused if every slot is still active.
BIOCHEF_MAX_RUNS=256

# Total execution slots shared by /runs and the legacy /convert route.
# Accepted /runs jobs beyond this limit wait in QUEUED.
BIOCHEF_MAX_CONCURRENT_RUNS=4

# Whether a bundle has to be signed by the Hub to run: off, warn or strict.
# off is what this service did before it could check, named so it is a choice.
# strict refuses anything without a signature the policy below accepts, and
# fails closed -- no cosign, no policy, or a registry the policy does not cover
# are all refusals rather than passes.
BIOCHEF_SIGNING_MODE=off

# The Hub's own policy document (biochef.signing-policy.v1), which pins the
# certificate identity, the OIDC issuer and the SLSA builder. Required by warn
# and strict; the same file the Hub verifies its own publishing against.
# BIOCHEF_SIGNING_POLICY=/etc/biochef/biochef-signing-policy.json
BIOCHEF_COSIGN=cosign
BIOCHEF_SLSA_VERIFIER=slsa-verifier

# How much of a run's output is kept. The TAIL is kept, because an error and
# the traceback around it arrive at the end.
BIOCHEF_MAX_LOG_BYTES=1048576

# Where a run's inputs may come from: upload (in-memory bytes),
# spooled (the request's temporary file), handedover (an Agent-owned copy for
# asynchronous runs), and optionally localpath (a file already on this host).
BIOCHEF_DATA_SOURCES=upload,spooled,handedover

# The only directory localpath may read from. It has no default, and
# localpath refuses to start without it -- the client chooses the path.
BIOCHEF_LOCAL_ROOT=

# How long a finished run's outputs remain fetchable, and how many runs may
# keep them at once. Either at 0 disables retention, restoring the old
# behaviour of deleting a workspace as soon as its run ends.
BIOCHEF_KEEP_OUTPUTS=3600
BIOCHEF_MAX_RETAINED_RUNS=32

# Where a node keeps what it has decided: study and workflow versions, requests,
# and signed decisions. Create the tables with: python -m store migrate
# BIOCHEF_DB_URL=sqlite:////var/lib/biochef/agent.db

# The node's private keys, outside any image and outside this repository, and
# readable by their owner only. Create them with: python -m node.keys init --out <dir>
# BIOCHEF_NODE_SIGNING_KEY=/etc/biochef/keys/node-signing.pem
# BIOCHEF_NODE_ENCRYPTION_KEY=/etc/biochef/keys/node-encryption.pem

# This node's name, shown on the page and written in its decisions.
# BIOCHEF_NODE_NAME=Example TRE

# The public key that signs the federation's node list.
# BIOCHEF_FEDERATION_KEY=/etc/biochef/federation.pub.pem

# How often the coordinator is polled.
# BIOCHEF_COORDINATOR_POLL_SECONDS=30

# How results leave this node: airlock or manual. Required by the page, and what
# turns on the mirror to the database in the API process.
# BIOCHEF_EGRESS_MODE=manual

# Where datasets live. Both need localpath in BIOCHEF_DATA_SOURCES and
# BIOCHEF_LOCAL_ROOT set. The file maps dataset ids to {type, location, visa_value}, and wins
# over anything bound on the page.
# BIOCHEF_DATASET_BINDINGS_FILE=/etc/biochef/datasets.yaml
BIOCHEF_DATASET_BINDINGS_FROM_UI=false

# Checking the ID tokens of study members.
# BIOCHEF_LS_LOGIN_ISSUER=https://login.aai.lifescience-ri.eu/oidc/
# BIOCHEF_EDITOR_CLIENT_ID=

# The page for the node's data manager, started with ./run-ui.sh. It refuses to
# start without BIOCHEF_AUDIT_LOG and without BIOCHEF_UI_IDENTITY.
# BIOCHEF_UI_HOST=127.0.0.1
# BIOCHEF_UI_PORT=8081
#
# header: a reverse proxy names the user, and is believed only from these CIDRs.
# BIOCHEF_UI_IDENTITY=header
# BIOCHEF_UI_IDENTITY_HEADER=X-Forwarded-User
# BIOCHEF_UI_TRUSTED_PROXIES=10.0.0.5/32
#
# dev: a fixed user, from a loopback address only.
# BIOCHEF_UI_IDENTITY=dev
# BIOCHEF_UI_DEV_USER=dev.user
#
# The page also needs the store (BIOCHEF_DB_URL, migrated with python -m store
# migrate) and the node's keys, and refuses to start without them.
#
# Where "Open Policy Engine" points. Unset hides the link.
# BIOCHEF_POLICY_ENGINE_URL=https://policy.example.org/

# Optional converter document inside the private per-run workspace.
BIOCHEF_WRITE_INTERMEDIATE=false
