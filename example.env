REGISTRY_URL=myregistry.com
REGISTRY_USERNAME=myregistry
REGISTRY_PASSWORD=12345
REGISTRY_INSECURE=false
ORAS_AUTH_BACKEND=basic
# How a workflow executes: subprocess (on the host, as this user) or apptainer
# (each step in a container). subprocess is the default; apptainer is what you
# want anywhere the data matters.
BIOCHEF_RUNNER=subprocess

# Under the apptainer runner. The image must carry a scheme and must contain
# bash -- snakemake runs each rule as `bash -c` inside it.
BIOCHEF_CONTAINER_IMAGE=docker://debian:stable-slim
BIOCHEF_APPTAINER_CACHE=apptainer-cache

# --contain hides other runs' files under /tmp from the container.
# --cleanenv prevents Agent variables from being inherited by tool processes.
BIOCHEF_APPTAINER_ARGS="--contain --cleanenv"

# Where a run's private directory is created. Unset means the system temp
# directory.
# BIOCHEF_RUN_ROOT=/var/lib/biochef/runs

BIOCHEF_RUN_TIMEOUT=900
BIOCHEF_KEEP_WORKSPACE=false
BIOCHEF_MAX_UPLOAD_BYTES=536870912
BIOCHEF_TOOL_CACHE=tool-cache

# GA4GH Passports, when BIOCHEF_AUTH=passport. The issuer is required; without
# it the service refuses to start rather than accept a token from anywhere.
# BIOCHEF_PASSPORT_ISSUER=https://login.aai.lifescience-ri.eu/oidc/
# Required. Without it, a token the same issuer minted for ANOTHER service is
# accepted here. Set it to 'any' only if the issuer mints audience-less tokens,
# and understand that this accepts any token that issuer ever signed.
# BIOCHEF_PASSPORT_AUDIENCE=biochef-agent
# BIOCHEF_PASSPORT_JWKS_URL=
# BIOCHEF_PASSPORT_USERINFO_URL=
#
# Whose visas count. A visa is only worth something if its issuer was named in
# advance -- otherwise anybody can mint themselves the visa you are requiring,
# which is why REQUIRE_VISA without VISA_ISSUERS refuses to start.
# BIOCHEF_PASSPORT_VISA_ISSUERS=https://controller.example.org
# BIOCHEF_PASSPORT_REQUIRE_VISA=ControlledAccessGrants
# BIOCHEF_PASSPORT_REQUIRE_VISA_VALUE=https://datasets.example.org/1

# Who may call this service: none (anyone who can reach it) or bearer.
# With bearer, requests need Authorization: Bearer <BIOCHEF_AUTH_TOKEN>.
# Selecting bearer without a token stops the service from starting.
BIOCHEF_AUTH=none
BIOCHEF_AUTH_TOKEN=

# How many runs are remembered for polling. The oldest finished run is
# forgotten when full; a new request is refused if every slot is still active.
BIOCHEF_MAX_RUNS=256

# Total execution slots shared by /runs and the legacy /convert route.
# Accepted /runs jobs beyond this limit wait in QUEUED.
BIOCHEF_MAX_CONCURRENT_RUNS=4

# Whether a bundle has to be signed by the Hub to run: off, warn or strict.
# off is what this service did before it could check, named so it is a choice.
# strict refuses anything without a signature the policy below accepts, and
# fails closed -- no cosign, no policy, or a registry the policy does not cover
# are all refusals rather than passes.
BIOCHEF_SIGNING_MODE=off

# The Hub's own policy document (biochef.signing-policy.v1), which pins the
# certificate identity, the OIDC issuer and the SLSA builder. Required by warn
# and strict; the same file the Hub verifies its own publishing against.
# BIOCHEF_SIGNING_POLICY=/etc/biochef/biochef-signing-policy.json
BIOCHEF_COSIGN=cosign
BIOCHEF_SLSA_VERIFIER=slsa-verifier

# How much of a run's output is kept. The TAIL is kept, because an error and
# the traceback around it arrive at the end.
BIOCHEF_MAX_LOG_BYTES=1048576

# Where a run's inputs may come from: upload (in-memory bytes),
# spooled (the request's temporary file), handedover (an Agent-owned copy for
# asynchronous runs), and optionally localpath (a file already on this host).
BIOCHEF_DATA_SOURCES=upload,spooled,handedover

# The only directory localpath may read from. It has no default, and
# localpath refuses to start without it -- the client chooses the path.
BIOCHEF_LOCAL_ROOT=

# How long a finished run's outputs remain fetchable, and how many runs may
# keep them at once. Either at 0 disables retention, restoring the old
# behaviour of deleting a workspace as soon as its run ends.
BIOCHEF_KEEP_OUTPUTS=3600
BIOCHEF_MAX_RETAINED_RUNS=32
