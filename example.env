REGISTRY_URL=myregistry.com
REGISTRY_USERNAME=myregistry
REGISTRY_PASSWORD=12345
REGISTRY_INSECURE=false
ORAS_AUTH_BACKEND=basic
# How a workflow executes: subprocess (on the host, as this user) or apptainer
# (each step in a container). subprocess is the default; apptainer is what you
# want anywhere the data matters.
BIOCHEF_RUNNER=subprocess

# Under the apptainer runner. The image must carry a scheme and must contain
# bash -- snakemake runs each rule as `bash -c` inside it.
BIOCHEF_CONTAINER_IMAGE=docker://debian:stable-slim
BIOCHEF_APPTAINER_CACHE=apptainer-cache

# Apptainer binds the host's /tmp unless told not to, and that is where a run's
# directory lives by default. Without --contain a containerised tool can read
# every other run's data.
BIOCHEF_APPTAINER_ARGS=--contain

# Where a run's private directory is created. Unset means the system temp
# directory.
# BIOCHEF_RUN_ROOT=/var/lib/biochef/runs

BIOCHEF_RUN_TIMEOUT=900
BIOCHEF_KEEP_WORKSPACE=false
BIOCHEF_MAX_UPLOAD_BYTES=536870912
BIOCHEF_TOOL_CACHE=tool-cache

# An append-only JSONL record of every state each run reaches: who asked, which
# run, which state, when. Unset writes no trail. Append-only is not immutable --
# put it somewhere the service cannot rewrite if that matters. If it cannot be
# written, runs fail rather than proceeding unrecorded.
# BIOCHEF_AUDIT_LOG=/var/log/biochef/audit.jsonl

# Who may call this service: none (anyone who can reach it) or bearer.
# With bearer, requests need Authorization: Bearer <BIOCHEF_AUTH_TOKEN>.
# Selecting bearer without a token stops the service from starting.
BIOCHEF_AUTH=none
BIOCHEF_AUTH_TOKEN=

# How many runs are remembered for polling. The oldest FINISHED run is
# forgotten when this is reached; a run still in flight is never evicted.
BIOCHEF_MAX_RUNS=256

# How many runs execute at once. Beyond this they wait in QUEUED, which is
# what that WES state means. Accepting work is cheap; doing it is not.
BIOCHEF_MAX_CONCURRENT_RUNS=4

# How much of a run's output is kept. The TAIL is kept, because an error and
# the traceback around it arrive at the end.
BIOCHEF_MAX_LOG_BYTES=1048576

# Where a run's inputs may come from: upload (pushed in the request),
# localpath (a file already on this host), or both, comma separated.
BIOCHEF_DATA_SOURCES=upload

# The only directory localpath may read from. It has no default, and
# localpath refuses to start without it -- the client chooses the path.
BIOCHEF_LOCAL_ROOT=

# How long a finished run's outputs remain fetchable, and how many runs may
# keep them at once. Either at 0 disables retention, restoring the old
# behaviour of deleting a workspace as soon as its run ends.
BIOCHEF_KEEP_OUTPUTS=3600
BIOCHEF_MAX_RETAINED_RUNS=32
