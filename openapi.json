                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Wes Run Log"
      }
    },
    "/ga4gh/wes/v1/runs/{run_id}/cancel": {
      "post": {
        "description": "The same cancellation the bespoke endpoint performs, called rather than\nrepeated: two implementations of stopping a process group would be two\nthings to keep correct, and the second is the one that gets forgotten.",
        "operationId": "wes_cancel_run_ga4gh_wes_v1_runs__run_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
