  "paths": {
    "/convert": {
      "post": {
        "description": "The editor's synchronous contract, sharing the execution limit.\n\nKept as it was because it is the contract the editor speaks today. /runs is\nthe same work without the wait.",
        "operationId": "convert_convert_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_convert_convert_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Convert"
      }
    },
    "/ga4gh/wes/v1/runs": {
      "get": {
        "description": "Every run still held.\n\npage_size and page_token are accepted and ignored, which service-info says\nunder not_implemented. Refusing them would fail conformant clients that send\na page size by default; pretending to honour them would silently return a\ndifferent set than was asked for.",
        "operationId": "wes_list_runs_ga4gh_wes_v1_runs_get",
        "parameters": [
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "title": "Page Size",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "title": "Page Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Wes List Runs"
      },
      "post": {
        "description": "WES's submission, mapped onto the same machinery as POST /runs.\n\nAnswers 200 with a run_id, which is what WES specifies -- the bespoke\nendpoint answers 202, and the difference is the specification's rather than\na disagreement about what happened.",
        "operationId": "wes_run_workflow_ga4gh_wes_v1_runs_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_wes_run_workflow_ga4gh_wes_v1_runs_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Wes Run Workflow"
      }
    },
