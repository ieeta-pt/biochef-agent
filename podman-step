#!/usr/bin/env bash
# Runs one Snakemake step in a container. Snakemake has no podman mode, so
# PodmanRunner makes this script the shell its rules run under, and each rule's
# command arrives here as `-c <command>`, in the run's workspace.
#
# --network=none is here and not a setting: a step reaches nothing, whatever the
# deployment says. Nothing of the agent's environment is passed in, and only this
# workspace is mounted, so a step sees neither credentials nor another run.
#
# The label is how PodmanRunner finds a container that outlives a killed run.
#
# BIOCHEF_PODMAN_SELINUX is disable or keep, and PodmanRunner refuses to start
# without one; this refuses too, so a step never runs on a guess.
set -euo pipefail

if [ "$#" -ne 2 ] || [ "$1" != "-c" ]; then
    echo "podman-step expects: -c <command>" >&2
    exit 2
fi

case "${BIOCHEF_PODMAN_SELINUX:-}" in
    disable) selinux=(--security-opt=label=disable) ;;
    keep) selinux=() ;;
    *)
        echo "podman-step: BIOCHEF_PODMAN_SELINUX must be disable or keep" >&2
        exit 2
        ;;
esac

exec podman run --rm --init --pull=missing \
    --network=none \
    --userns=keep-id \
    --cap-drop=all \
    --security-opt=no-new-privileges \
    ${selinux[@]+"${selinux[@]}"} \
    --label "biochef.run=$(basename "$PWD")" \
    --volume "$PWD:$PWD" \
    --workdir "$PWD" \
    "${BIOCHEF_PODMAN_IMAGE:?}" \
    bash -c "$2" </dev/null
